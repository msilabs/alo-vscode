{
    "name": "alo-vscode",
    "displayName": "Alo",
    "description": "Language support for the Alo static web framework.",
    "version": "0.0.1",
    "publisher": "msilabs",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "galleryBanner": {
        "color": "#1f1a14",
        "theme": "dark"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "scripts": {
        "test": "node --test \"test/unit/*.test.js\"",
        "test:editor": "node test/editor/run.js && node test/editor/run.js --alo-as-html && node test/editor/run.js --restricted",
        "test:editor:my-settings": "node test/editor/run.js --user-settings && node test/editor/run.js --user-settings --alo-as-html && node test/editor/run.js --user-settings --restricted"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In Restricted Mode, Alo does not check for errors, because that runs the code in your templates, and it does not load the project's own Alo from node_modules."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "Alo reads the project's folders from disk."
        }
    },
    "activationEvents": [
        "workspaceContains:**/*.alo"
    ],
    "contributes": {
        "configurationDefaults": {
            "emmet.includeLanguages": {
                "alo": "html"
            },
            "workbench.editor.customLabels.patterns": {
                "**/pages/**/page.alo": "${dirname} (page)",
                "**/pages/**/layout.alo": "${dirname} (layout)"
            }
        },
        "languages": [
            {
                "id": "alo",
                "aliases": ["Alo", "alo"],
                "extensions": [".alo"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/alo-file.svg",
                    "dark": "./icons/alo-file.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "alo",
                "scopeName": "text.html.alo",
                "path": "./syntaxes/alo.tmLanguage.json",
                "embeddedLanguages": {
                    "source.css": "css",
                    "source.js": "javascript"
                },
                "tokenTypes": {
                    "meta.tag string.quoted": "other"
                }
            }
        ],
        "snippets": [
            {
                "language": "alo",
                "path": "./snippets/alo.code-snippets"
            }
        ],
        "commands": [
            {
                "command": "alo.hello",
                "title": "Hello",
                "category": "Alo"
            },
            {
                "command": "alo.showOutput",
                "title": "Show Log",
                "category": "Alo"
            },
            {
                "command": "alo.useAloForAloFiles",
                "title": "Open .alo Files as Alo",
                "category": "Alo"
            }
        ]
    }
}
