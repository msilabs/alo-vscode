{
    "name": "alo-vscode",
    "displayName": "Alo",
    "description": "Language support for the Alo static web framework.",
    "version": "0.0.1",
    "publisher": "msilabs",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "galleryBanner": {
        "color": "#1f1a14",
        "theme": "dark"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [],
    "contributes": {
        "languages": [
            {
                "id": "alo",
                "aliases": ["Alo", "alo"],
                "extensions": [".alo"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/alo-file.svg",
                    "dark": "./icons/alo-file.svg"
                }
            }
        ],
        "commands": [
            {
                "command": "alo.hello",
                "title": "Hello",
                "category": "Alo"
            }
        ]
    }
}
