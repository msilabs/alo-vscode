{
    "name": "alo-vscode",
    "displayName": "Alo",
    "description": "Language support for the Alo static web framework.",
    "version": "0.0.1",
    "publisher": "msilabs",
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "galleryBanner": {
        "color": "#1f1a14",
        "theme": "dark"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [],
    "contributes": {
        "configurationDefaults": {
            "emmet.includeLanguages": {
                "alo": "html"
            },
            "workbench.editor.customLabels.patterns": {
                "**/pages/**/page.alo": "${dirname} (page)",
                "**/pages/**/layout.alo": "${dirname} (layout)"
            }
        },
        "languages": [
            {
                "id": "alo",
                "aliases": ["Alo", "alo"],
                "extensions": [".alo"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/alo-file.svg",
                    "dark": "./icons/alo-file.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "alo",
                "scopeName": "text.html.alo",
                "path": "./syntaxes/alo.tmLanguage.json",
                "embeddedLanguages": {
                    "source.css": "css",
                    "source.js": "javascript"
                },
                "tokenTypes": {
                    "meta.tag string.quoted": "other"
                }
            }
        ],
        "snippets": [
            {
                "language": "alo",
                "path": "./snippets/alo.code-snippets"
            }
        ],
        "commands": [
            {
                "command": "alo.hello",
                "title": "Hello",
                "category": "Alo"
            },
            {
                "command": "alo.showOutput",
                "title": "Show Log",
                "category": "Alo"
            }
        ]
    }
}
