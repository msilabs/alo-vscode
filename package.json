{
    "name": "alo-vscode",
    "displayName": "Alo",
    "description": "Alo static web framework: highlighting, component and data suggestions, Alo's own errors with quick fixes, the dev server and builds.",
    "version": "0.1.0",
    "publisher": "msilabs",
    "license": "MIT",
    "icon": "icons/alo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/msilabs/alo-vscode.git"
    },
    "homepage": "https://github.com/msilabs/alo-vscode#readme",
    "bugs": {
        "url": "https://github.com/msilabs/alo-vscode/issues"
    },
    "keywords": [
        "alo",
        "static site generator",
        "ssg",
        "html",
        "templates",
        "components",
        "bangla"
    ],
    "engines": {
        "vscode": "^1.90.0"
    },
    "galleryBanner": {
        "color": "#1f1a14",
        "theme": "dark"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "scripts": {
        "test": "node --test \"test/unit/*.test.js\"",
        "test:editor": "node test/editor/run.js && node test/editor/run.js --alo-as-html && node test/editor/run.js --restricted",
        "test:editor:my-settings": "node test/editor/run.js --user-settings && node test/editor/run.js --user-settings --alo-as-html && node test/editor/run.js --user-settings --restricted",
        "package": "npx @vscode/vsce package",
        "test:packaged": "node test/editor/run.js --packaged && node test/editor/run.js --packaged --alo-as-html && node test/editor/run.js --packaged --restricted"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In Restricted Mode, Alo does not check for errors or run the dev server and builds, because those run the code in your templates, and it does not load the project's own Alo from node_modules."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "Alo reads the project's folders from disk."
        }
    },
    "activationEvents": [
        "workspaceContains:**/*.alo"
    ],
    "contributes": {
        "configurationDefaults": {
            "emmet.includeLanguages": {
                "alo": "html"
            },
            "workbench.editor.customLabels.patterns": {
                "**/pages/**/page.alo": "${dirname} (page)",
                "**/pages/**/layout.alo": "${dirname} (layout)"
            }
        },
        "languages": [
            {
                "id": "alo",
                "aliases": ["Alo", "alo"],
                "extensions": [".alo"],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/alo-file.svg",
                    "dark": "./icons/alo-file.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "alo",
                "scopeName": "text.html.alo",
                "path": "./syntaxes/alo.tmLanguage.json",
                "embeddedLanguages": {
                    "source.css": "css",
                    "source.js": "javascript"
                },
                "tokenTypes": {
                    "meta.tag string.quoted": "other"
                }
            }
        ],
        "snippets": [
            {
                "language": "alo",
                "path": "./snippets/alo.code-snippets"
            }
        ],
        "commands": [
            {
                "command": "alo.showOutput",
                "title": "Show Log",
                "category": "Alo"
            },
            {
                "command": "alo.useAloForAloFiles",
                "title": "Open .alo Files as Alo",
                "category": "Alo"
            },
            {
                "command": "alo.new",
                "title": "New…",
                "category": "Alo"
            },
            {
                "command": "alo.startDevServer",
                "title": "Start Dev Server",
                "category": "Alo",
                "icon": "$(play)"
            },
            {
                "command": "alo.stopDevServer",
                "title": "Stop Dev Server",
                "category": "Alo",
                "icon": "$(debug-stop)"
            },
            {
                "command": "alo.openInBrowser",
                "title": "Open Dev Server in Browser",
                "category": "Alo"
            },
            {
                "command": "alo.build",
                "title": "Build",
                "category": "Alo"
            },
            {
                "command": "alo.previewPage",
                "title": "Open Page in Browser",
                "category": "Alo"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "alo.previewPage",
                    "when": "false"
                }
            ]
        }
    }
}
